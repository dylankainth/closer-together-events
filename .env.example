# Convex deployment URL. Local dev: printed by `npx convex dev` once logged in.
# Self-hosted (keanu's VPS): the HTTPS URL keanu DMs once it's up.
EXPO_PUBLIC_CONVEX_URL=

# Login with Facebook (needs a development build: `npx expo run:ios`, not Expo Go).
# App id + client token come from the Facebook app (Settings > Basic and Settings > Advanced).
# Every demo account must be added as a Tester while the Facebook app is in Development mode.
EXPO_PUBLIC_FB_APP_ID=
FB_CLIENT_TOKEN=
# Must match the iOS bundle id / Android package registered in the Facebook app.
IOS_BUNDLE_ID=com.closertogether.museevents
ANDROID_PACKAGE=com.closertogether.museevents
# Server side, set on the Convex deployment (never in this file):
#   npx convex env set FB_APP_ID <app id>
#   npx convex env set FB_APP_SECRET <app secret>
